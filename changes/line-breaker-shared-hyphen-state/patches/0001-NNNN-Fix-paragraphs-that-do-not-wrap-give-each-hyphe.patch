From 38c9316ebd4a933a85b3d4896755cb962317263a Mon Sep 17 00:00:00 2001
From: Gennady Uraltsev <gennady.uraltsev@gmail.com>
Date: Sun, 18 Oct 2026 12:36:57 -0500
Subject: [PATCH] [NNNN] Fix paragraphs that do not wrap: give each hyphenation
 point its own lb_info

c87f08744 ([6018], "atomic path array index") moved the per-position records
of atomic break positions into an array and routed all lookups through
get_lb_info. In doing so it replaced

    if (!best->contains (new_pos)) best (new_pos)= lb_info ();
    lb_info cur= best[new_pos];

by `get_lb_info (new_pos)`, which returns `best (pos)` for non-atomic paths.
lb_info is a reference-counted handle and a hashmap creates a new entry by
copying its default value, so every hyphenation point of a paragraph then
shared one (prev, pen, pen_spc) record. The optimal-break chain got mixed up
and a paragraph could come out as one overfull line that only breaks at a
hyphen point near its end.

Allocate a fresh lb_info for each new non-atomic position in test_better and
read with best[pos] again, as before c87f08744.

Adds three regression tests that use real fonts and hyphenation patterns
(a minimal English paragraph, a longer one, German compounds). Each sweeps
101 line widths and checks monotonic breaks, line count and line width. All
three fail without the fix and pass with it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/Typeset/Line/line_breaker.cpp        |   5 +-
 tests/Typeset/Line/line_breaker_test.cpp | 131 ++++++++++++++++++++++-
 2 files changed, 133 insertions(+), 3 deletions(-)

diff --git a/src/Typeset/Line/line_breaker.cpp b/src/Typeset/Line/line_breaker.cpp
index 9a8556a7e..676928bd8 100644
--- a/src/Typeset/Line/line_breaker.cpp
+++ b/src/Typeset/Line/line_breaker.cpp
@@ -68,7 +68,7 @@ struct line_breaker_rep {
 
   inline lb_info get_lb_info (path pos) {
     if (is_atom (pos) && pos->item <= end) return atom_best[pos->item];
-    return best (pos);
+    return best[pos];
   }
 
   void        empty_line_fix (line_item& first, path& pos, int& cur_nr);
@@ -266,6 +266,9 @@ line_breaker_rep::compute_ragged_breaks () {
 void
 line_breaker_rep::test_better (path new_pos, path old_pos, int pen,
                                PEN pen_spc) {
+  // lb_info 是引用语义，哈希表新条目共享同一个默认值，须为每个断字位置单独分配
+  if ((!is_atom (new_pos) || new_pos->item > end) && !best->contains (new_pos))
+    best (new_pos)= lb_info ();
   lb_info cur= get_lb_info (new_pos);
   // cout << "Test " << new_pos << " vs " << old_pos
   //      << ", " << pen << " vs " << cur->pen
diff --git a/tests/Typeset/Line/line_breaker_test.cpp b/tests/Typeset/Line/line_breaker_test.cpp
index 31d1d119e..3e01d8332 100644
--- a/tests/Typeset/Line/line_breaker_test.cpp
+++ b/tests/Typeset/Line/line_breaker_test.cpp
@@ -10,7 +10,13 @@
 
 #include "Boxes/construct.hpp"
 #include "Format/line_item.hpp"
+#include "Metafont/load_tex.hpp"
+#include "base.hpp"
+#include "data_cache.hpp"
+#include "font.hpp"
 #include "line_breaker.hpp"
+#include "smart_font.hpp"
+#include "tm_sys_utils.hpp"
 #include <QtTest/QtTest>
 
 class MockCjkBoxRep : public box_rep {
@@ -23,8 +29,8 @@ public:
     y2= w;
   }
   string get_leaf_string () override { return str; }
-  operator tree () override { return tree ("mock"); }
-  void display (renderer) override {}
+         operator tree () override { return tree ("mock"); }
+  void   display (renderer) override {}
 };
 
 box
@@ -52,12 +58,133 @@ class TestLineBreaker : public QObject {
   Q_OBJECT
 
 private slots:
+  void init () {
+    init_lolly ();
+    init_texmacs_home_path ();
+    cache_initialize ();
+    init_tex ();
+  }
+
+  void test_hyphenation_keeps_lines_within_width ();
+  void test_hyphenation_long_paragraph ();
+  void test_hyphenation_german_compounds ();
   void test_atomic_line_breaks ();
   void test_forbidden_break_at_penalty ();
   void test_single_cjk_char_atomic ();
   void test_empty_or_single_item ();
 };
 
+/**
+ * @brief 回归 [c87f08744]：断字候选位置曾共用同一份
+ * lb_info，使最优断点链被串乱，
+ *        段落整体不折行（单行超宽，只在某个断字点才换行）。
+ * @note 用真实字体和断字模式排一个段落并扫描一批行宽。每个结果须满足：
+ *       断点单调；行数不少于总宽度所需；任何一行（不含两端断字残余）都不得明显
+ *       超过 large_width（容差 25% 用于吸收窄行时允许的轻微超宽）。
+ */
+static void
+check_paragraph_wraps (const char* lang, const char** words, int n) {
+  tree which= tree (TUPLE, "roman", "rm", "medium", "right", "$s", "$d");
+  tree by   = tree (TUPLE, "ec", "ecrm", "$s", "$d");
+  font_rule (which, by);
+  font fn= smart_font ("roman", "rm", "medium", "right", 10, 600);
+  QVERIFY (!is_nil (fn));
+
+  language         lan= text_language (lang);
+  array<line_item> a (n);
+  SI               total= 0;
+  for (int i= 0; i < n; i++) {
+    box b    = text_box (path (i), 0, string (words[i]), fn, pencil (black));
+    a[i]     = line_item (STRING_ITEM, OP_TEXT, b, i == n - 1 ? 0 : 1, lan);
+    a[i]->spc= i == n - 1 ? space (0) : fn->spc;
+    total+= b->w () + a[i]->spc->def;
+  }
+
+  for (int k= 150; k <= 450; k+= 3) {
+    SI          line_width = total * 100 / k;
+    SI          large_width= (SI) (line_width / 0.9);
+    SI          limit      = large_width + large_width / 4;
+    array<path> ap= line_breaks (a, 0, n, line_width, large_width, 0, 0);
+    QCOMPARE (ap[0], path (0));
+    QCOMPARE (ap[N (ap) - 1], path (n));
+    QVERIFY2 (
+        N (ap) - 1 >= (int) (total / limit),
+        qPrintable (QString ("k=%1: only %2 lines").arg (k).arg (N (ap) - 1)));
+    for (int j= 0; j + 1 < N (ap); j++) {
+      QVERIFY (ap[j]->item <= ap[j + 1]->item);
+      // 起点为断字残余或终点为断字时少算一个词，结果偏保守
+      int from= is_atom (ap[j]) ? ap[j]->item : ap[j]->item + 1;
+      int to  = ap[j + 1]->item;
+      SI  w   = 0;
+      for (int i= from; i < to; i++)
+        w+= a[i]->b->w () + (i + 1 < to ? a[i]->spc->def : 0);
+      QVERIFY2 (w <= limit, qPrintable (QString ("k=%1 line %2 width %3 > %4")
+                                            .arg (k)
+                                            .arg (j)
+                                            .arg (w)
+                                            .arg (limit)));
+    }
+  }
+}
+
+// 最小复现：去掉 "alonggggg " 或 "boundarie " 任一词，旧代码就恢复正常
+void
+TestLineBreaker::test_hyphenation_keeps_lines_within_width () {
+  const char* words[]= {"where",     "are",       "Schwartz",   "functions",
+                        "on",        "the",       "real",       "line.",
+                        "This",      "operator",  "arises",     "in",
+                        "diverse",   "contexts:", "averages",   "of",
+                        "over",      "yield",     "relevant",   "correction",
+                        "terms",     "for",       "evaluating", "Cauchy",
+                        "integrals", "alonggggg", "boundarie",  "boundaries"};
+  check_paragraph_wraps ("english", words, sizeof (words) / sizeof (words[0]));
+}
+
+// 较长段落：断字点更多，错误的最优链在更多行宽下出现
+void
+TestLineBreaker::test_hyphenation_long_paragraph () {
+  const char* words[]= {
+      "evaluating",   "Cauchy",       "integrals",    "along",
+      "boundaries",   "of",           "Lipschitz",    "domains",
+      "and",          "for",          "inverting",    "elliptic",
+      "operators",    "with",         "non-constant", "coefficients;",
+      "fiberwise",    "applications", "of",           "bounds",
+      "on",           "can",          "be",           "used",
+      "to",           "bound",        "multilinear",  "singular",
+      "integral",     "opertors",     "with",         "full",
+      "symmetry.",    "We",           "elaborate",    "and",
+      "provide",      "references",   "for",          "these",
+      "applications", "further",      "on.",          "One",
+      "is",           "interested",   "in",           "showing",
+      "the",          "bounds",       "with",         "a",
+      "constant",     "that",         "does",         "not",
+      "depend",       "on",           "the",          "functions."};
+  check_paragraph_wraps ("english", words, sizeof (words) / sizeof (words[0]));
+}
+
+// 德语复合词：几乎每个词都有多个断字候选，另一套断字模式
+void
+TestLineBreaker::test_hyphenation_german_compounds () {
+  const char* words[]= {"Die",
+                        "Donaudampfschifffahrtsgesellschaft",
+                        "verwendet",
+                        "Rindfleischetikettierungsueberwachungsaufgaben",
+                        "und",
+                        "Haftpflichtversicherungsbedingungen",
+                        "fuer",
+                        "alle",
+                        "Geschwindigkeitsbegrenzungen",
+                        "in",
+                        "der",
+                        "Bundesrepublik",
+                        "Deutschland",
+                        "sowie",
+                        "Arbeitsunfaehigkeitsbescheinigungen",
+                        "der",
+                        "Krankenversicherung"};
+  check_paragraph_wraps ("german", words, sizeof (words) / sizeof (words[0]));
+}
+
 void
 TestLineBreaker::test_atomic_line_breaks () {
   // 构造 10 个宽度为 1000 tmpt 的图元，换行罚分为 0（允许换行）

