From 58148954abf246b8f717b1ce03ba8e079eeef85f Mon Sep 17 00:00:00 2001
From: Gennady Uraltsev <gennady.uraltsev@gmail.com>
Date: Sat, 17 Oct 2026 19:40:21 -0500
Subject: [PATCH] Support amsmath aligned and gathered: gathered macro, LaTeX
 import and export

Add gathered, the centered one-column counterpart of aligned.  Placed inside
equation it gives several centered rows under a single equation number.  Mogan
had aligned (two columns, right/left) and gather (one number per row) but
nothing for this case.  The macro is defined in env-math.stem like aligned*,
with one centered column.

LaTeX export needs no new code (tables are exported generically as
\begin{gathered}); only the amsmath package dependency is declared for
begin-aligned and begin-gathered.

LaTeX import: \begin{aligned} and \begin{gathered} become the native macros
with a real table, one row per row separator, and the optional [t|b|c]
argument is stored as table-valign (default c).  aligned columns that are empty
in every row (leading or trailing alignment marker) lose their width.  The
optional argument of aligned never worked: the parser renames the environment
to "aligned*" once it has consumed [t]/[b], and finalize_pmatrix only matched
the plain name, so the table was built by a generic path that left the argument
behind as a stray macro argument.  Match both spellings.

Make gathered and aligned variants of each other, so that Ctrl+Tab on either one
switches to the other.  Both take the same body, so the rows are kept.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 TeXmacs/packages/environment/env-math.stem    | 16 +++++
 .../progs/latex/convert-latex-command-drd.scm |  4 +-
 .../latex/progs/latex/convert-latex-drd.scm   |  2 +
 TeXmacs/progs/math/math-edit.scm              |  2 +
 src/Plugins/Tex/fromtex_post.cpp              | 67 ++++++++++++++++++-
 5 files changed, 86 insertions(+), 5 deletions(-)

diff --git a/TeXmacs/packages/environment/env-math.stem b/TeXmacs/packages/environment/env-math.stem
index 5779262ef..e5f23c451 100644
--- a/TeXmacs/packages/environment/env-math.stem
+++ b/TeXmacs/packages/environment/env-math.stem
@@ -258,6 +258,22 @@
         ) ;macro
       ) ;assign
       (assign "aligned" (macro "body" (document (aligned* (tformat (arg "body"))))))
+      (assign "gathered"
+        (macro "body"
+          (document (math-table-base (tformat (twith "table-min-cols" "1")
+                                       (twith "table-max-cols" "1")
+                                       (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
+                                       (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
+                                       (cwith "1" "-1" "1" "-1" "cell-bsep" "0.1fn")
+                                       (cwith "1" "-1" "1" "-1" "cell-tsep" "0.1fn")
+                                       (cwith "1" "-1" "1" "-1" "cell-halign" "c")
+                                       (cwith "1" "-1" "1" "-1" "cell-block" "no")
+                                       (arg "body")
+                                     ) ;tformat
+                    ) ;math-table-base
+          ) ;document
+        ) ;macro
+      ) ;assign
       (assign "alignedat*"
         (macro "ncol" "body" (document (aligned* (tformat (arg "body")))))
       ) ;assign
diff --git a/TeXmacs/plugins/latex/progs/latex/convert-latex-command-drd.scm b/TeXmacs/plugins/latex/progs/latex/convert-latex-command-drd.scm
index 94f4daaa5..2e0762c8d 100644
--- a/TeXmacs/plugins/latex/progs/latex/convert-latex-command-drd.scm
+++ b/TeXmacs/plugins/latex/progs/latex/convert-latex-command-drd.scm
@@ -454,8 +454,8 @@
 ) ;logic-group
 
 (logic-group latex-environment-0*% begin-figure begin-table begin-figure*
-  begin-table* begin-algorithmic begin-algorithm begin-algorithm2e
-  begin-teaserfigure
+  begin-table* begin-aligned begin-gathered begin-algorithmic begin-algorithm
+  begin-algorithm2e begin-teaserfigure
 ) ;logic-group
 
 (logic-group latex-environment-1% begin-otherlanguage begin-otherlanguage*
diff --git a/TeXmacs/plugins/latex/progs/latex/convert-latex-drd.scm b/TeXmacs/plugins/latex/progs/latex/convert-latex-drd.scm
index 5fbd54ac3..1823feb4d 100644
--- a/TeXmacs/plugins/latex/progs/latex/convert-latex-drd.scm
+++ b/TeXmacs/plugins/latex/progs/latex/convert-latex-drd.scm
@@ -83,6 +83,8 @@
 
   (begin-align "amsmath")
   (begin-align* "amsmath")
+  (begin-aligned "amsmath")
+  (begin-gathered "amsmath")
   (begin-alignat "amsmath")
   (begin-alignat* "amsmath")
   (begin-xalignat "amsmath")
diff --git a/TeXmacs/progs/math/math-edit.scm b/TeXmacs/progs/math/math-edit.scm
index 53d157ab0..01fb0bb2a 100644
--- a/TeXmacs/progs/math/math-edit.scm
+++ b/TeXmacs/progs/math/math-edit.scm
@@ -27,9 +27,11 @@
 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 
 (define-group variant-tag (math-table-tag))
+(define-group variant-tag (aligned-block-tag))
 (define-group similar-tag (math-table-tag))
 
 (define-group math-table-tag matrix det bmatrix Bmatrix)
+(define-group aligned-block-tag gathered aligned)
 
 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 ;; Spaces
diff --git a/src/Plugins/Tex/fromtex_post.cpp b/src/Plugins/Tex/fromtex_post.cpp
index b28f0eb92..1f6a797e9 100644
--- a/src/Plugins/Tex/fromtex_post.cpp
+++ b/src/Plugins/Tex/fromtex_post.cpp
@@ -256,10 +256,40 @@ trim_cell_spaces (tree t) {
   return t;
 }
 
+static bool
+empty_aligned_cell (tree t) {
+  if (is_atomic (t)) return t == "";
+  if (!is_func (t, CONCAT)) return false;
+  for (int i= 0; i < N (t); i++)
+    if (!empty_aligned_cell (t[i])) return false;
+  return true;
+}
+
 static void
 parse_pmatrix (tree& r, tree t, int& i, string lb, string rb, string fm) {
   tree tformat (TFORMAT);
-  if (N (t[i]) == 2 && t[i][0] != "tabular") {
+  // The parser appends '*' to the name when it consumed an optional argument.
+  bool amsmath_block= t[i][0] == "aligned" || t[i][0] == "aligned*" ||
+                      t[i][0] == "gathered" || t[i][0] == "gathered*";
+  if (N (t[i]) == 1 && amsmath_block) {
+    // amsmath's aligned and gathered default to vertical centering on the
+    // math axis.
+    tformat << tree (TWITH, TABLE_VALIGN, "f");
+  }
+  else if (N (t[i]) == 2 && amsmath_block) {
+    // The optional argument of aligned/gathered is its vertical position
+    // relative to the surrounding math.  Keep it on the TeXmacs table, not on
+    // its cells.
+    // LaTeX [t]/[b] align the baseline of the first/last row, which are the
+    // uppercase TeXmacs modes; lowercase t/b are the geometric top/bottom.
+    // [c] (and the default) centers on the math axis, mode "f".
+    tree valign= t[i][1];
+    if (valign == "t") valign= "T";
+    else if (valign == "b") valign= "B";
+    else valign= "f";
+    tformat << tree (TWITH, TABLE_VALIGN, valign);
+  }
+  else if (N (t[i]) == 2 && t[i][0] != "tabular") {
     tformat= parse_matrix_params (t[i][1]);
   }
   else if (N (t[i]) == 2 && t[i][0] == "tabular") {
@@ -372,6 +402,7 @@ parse_pmatrix (tree& r, tree t, int& i, string lb, string rb, string fm) {
     else if (v == tree (END, "vmatrix")) break;
     else if (v == tree (END, "smallmatrix")) break;
     else if (v == tree (END, "aligned")) break;
+    else if (v == tree (END, "gathered")) break;
     else if (v == tree (APPLY, "hline") || is_apply (v, "toprule", 0) ||
              is_apply (v, "midrule", 0) || is_apply (v, "bottomrule", 0)) {
       bool is_booktabs= is_apply (v, "toprule", 0) ||
@@ -487,6 +518,25 @@ parse_pmatrix (tree& r, tree t, int& i, string lb, string rb, string fm) {
       else R << tree (CELL, "");
     M << R;
   }
+  if (fm == "aligned") {
+    // An ampersand can create a leading or trailing column which is empty in
+    // every row.  It is an alignment marker, not visible table content, so
+    // remove both its forced width and its cell padding.  Do not collapse a
+    // merely empty cell: its column may contain the alignment anchor in a
+    // different row.
+    for (x= 0; x < cols; x++) {
+      bool empty_column= true;
+      for (y= 0; y < rows; y++)
+        empty_column= empty_column && empty_aligned_cell (M[y][x][0]);
+      if (empty_column) {
+        string col= as_string (x + 1);
+        tformat << tree (CWITH, "1", "-1", col, col, CELL_HMODE, "exact");
+        tformat << tree (CWITH, "1", "-1", col, col, CELL_WIDTH, "0spc");
+        tformat << tree (CWITH, "1", "-1", col, col, CELL_LSEP, "0spc");
+        tformat << tree (CWITH, "1", "-1", col, col, CELL_RSEP, "0spc");
+      }
+    }
+  }
   tformat << trim_cell_spaces (M);
   if (is_three_line_table) {
     r << compound ("three-line-table", tformat);
@@ -514,8 +564,14 @@ finalize_pmatrix (tree t) {
                  u[i][0] == "tabularx" || u[i][0] == "tabularx*")
           parse_pmatrix (r, u, i, "", "", "tabular*");
         else if (u[i][0] == "cases") parse_pmatrix (r, u, i, "", "", "choice");
-        else if (u[i][0] == "aligned")
-          parse_pmatrix (r, u, i, "", "", "tabular*");
+        else if (u[i][0] == "aligned" || u[i][0] == "aligned*")
+          // Do not flatten amsmath's aligned into a generic tabular*.  The
+          // native aligned macro has the alternating right/left column
+          // layout and zero outer cell padding required for a leading or
+          // trailing '&' to have no visible width of its own.
+          parse_pmatrix (r, u, i, "", "", "aligned");
+        else if (u[i][0] == "gathered" || u[i][0] == "gathered*")
+          parse_pmatrix (r, u, i, "", "", "gathered");
         else if (u[i][0] == "stack") parse_pmatrix (r, u, i, "", "", "stack");
         else if (u[i][0] == "subarray")
           parse_pmatrix (r, u, i, "", "", "stack");
@@ -923,6 +979,11 @@ finalize_layout (tree t) {
         }
 
         if (v == tree (BEGIN, "displaymath")) v= tree (BEGIN, "equation*");
+        // The parser adds '*' to a command label when it consumed an optional
+        // argument.  Unlike the real starred environments, amsmath has no
+        // aligned* environment, so normalize this internal marker here.
+        if (v[0] == "aligned*") v[0]= "aligned";
+        if (v[0] == "gathered*") v[0]= "gathered";
         if (v == tree (BEGIN, "math")) {
           r << tree (SET, MODE, "math");
           spc_flag= item_flag= false;

